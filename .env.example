# Operator desk (/admin/leads) – set these in Vercel > Project > Settings > Environment Variables
OPERATOR_USERNAME=your-login-email
OPERATOR_PASSWORD=choose-a-long-unique-password
OPERATOR_SESSION_SECRET=paste-a-random-64-character-string

# Optional cloud storage for bookings/visitor count (Upstash Redis / Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=
NEXT_PUBLIC_SITE_URL=https://ridevo.in
